---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map(entry => ({
    params: { slug: entry.id === 'overview' ? undefined : entry.id === 'api/index' ? 'api' : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---
<DocsLayout entry={entry} headings={headings} entries={entries}>
  <Content />
</DocsLayout>
